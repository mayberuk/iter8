---
import Card from "../components/Card.astro"
import "../style.css"
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>astro</title>

</head>
<body>
  <header><h1>astro</h1></header>
  <nav aria-label="Main navigation"><a href="/">Home</a><a href="/second">Second page</a></nav>
  <main>
    <section aria-labelledby="overview-heading">
      <h2 id="overview-heading">Overview</h2>
      <Card />
      <button type="button">Save</button>
    </section>
    <section aria-labelledby="details-heading">
      <h2 id="details-heading">Details</h2>
      <p>Details for the astro page.</p>
      <button type="button">Save</button>
    </section>
    <section aria-labelledby="notes-heading">
      <h2 id="notes-heading">Notes</h2>
      <form>
        <label for="title">Title</label>
        <input id="title" name="title" type="text" />
        <label for="notes">Notes</label>
        <textarea id="notes" name="notes"></textarea>
        <button type="button">Save</button>
      </form>
    </section>

  </main>
  <aside aria-label="Related information"><p>Related information for astro.</p></aside>
  <footer><p>Footer for astro.</p></footer>
</body>
</html>
