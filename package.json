{
  "name": "iter8",
  "private": true,
  "type": "module",
  "version": "0.5.0-rc.1",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "harness",
    "fixtures/*",
    "playground"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:claude": "ITER8_BIN=$PWD/scripts/iter8-dev claude",
    "prod": "iter8 run playground",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "knip": "knip",
    "depcruise": "depcruise --config .dependency-cruiser.cjs .",
    "test": "bun test --parallel=16 --timeout 120000 --path-ignore-patterns=\"**/*.budget.test.ts\" --path-ignore-patterns=\"plugins/**\" && bun test --timeout 120000 .budget.test.",
    "test:plugin": "plugins/iter8/tests/run-all.sh",
    "check": "bun run typecheck && bun run lint && bun run knip && bun run depcruise && bun run test && bun run test:plugin",
    "setup:browsers": "playwright install chromium",
    "build": "bun scripts/build.ts",
    "build:overlay": "bun scripts/build.ts overlay",
    "release": "bun scripts/release.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@iter8/protocol": "workspace:*",
    "@jridgewell/trace-mapping": "0.3.31",
    "@preact/signals": "2.11.3",
    "bippy": "0.7.3",
    "citty": "0.2.2",
    "hono": "4.13.13",
    "markdown-to-jsx": "9.10.3",
    "modern-screenshot": "4.7.0",
    "parse5": "8.0.1",
    "pino": "10.4.0",
    "preact": "11.0.1",
    "sugar-high": "2.5.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@swc/core": "1.16.13",
    "@types/bun": "1.4.2",
    "dependency-cruiser": "18.5.0",
    "fast-check": "4.10.2",
    "knip": "6.41.0",
    "playwright": "1.64.0",
    "typescript": "7.0.2"
  }
}
