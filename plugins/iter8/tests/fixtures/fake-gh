#!/usr/bin/env bash
set -uo pipefail

printf -v ARGS '%q ' "$@"
printf '%s\n' "${ARGS% }" >> "$FAKE_GH_LOG"
if [ "${1:-}" = auth ] && [ "${2:-}" = status ]; then
  [ "${FAKE_GH_AUTH:-}" != fail ]
  exit "$?"
fi
[ "${1:-}" = release ] && [ "${2:-}" = download ] || exit 1
shift 2
[ "$#" -gt 0 ] || exit 1
shift
PATTERNS=()
DIR=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --repo) [ "$#" -ge 2 ] || exit 1; shift 2 ;;
    --pattern) [ "$#" -ge 2 ] || exit 1; PATTERNS+=("$2"); shift 2 ;;
    --dir) [ "$#" -ge 2 ] || exit 1; DIR="$2"; shift 2 ;;
    *) exit 1 ;;
  esac
done
[ -n "$DIR" ] && [ "${#PATTERNS[@]}" -gt 0 ] || exit 1
[ "${FAKE_DOWNLOAD:-}" != fail ] || exit 1
[ -z "${FAKE_DELAY:-}" ] || sleep "$FAKE_DELAY"
for NAME in "${PATTERNS[@]}"; do
  [ -f "$FAKE_ASSETS/$NAME" ] || exit 1
  if [ "$NAME" != SHA256SUMS ]; then
    COUNTER="$FAKE_ASSETS/$NAME.count"
    while ! mkdir "$COUNTER.lock" 2>/dev/null; do sleep 1; done
    COUNT=0
    [ ! -f "$COUNTER" ] || COUNT="$(<"$COUNTER")"
    printf '%s\n' "$((COUNT + 1))" > "$COUNTER"
    rmdir "$COUNTER.lock" || exit 1
  fi
  cp "$FAKE_ASSETS/$NAME" "$DIR/$NAME" || exit 1
done
